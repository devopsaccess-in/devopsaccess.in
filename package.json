{
  "name": "devopsaccess",
  "version": "0.1.0",
  "private": true,
  "description": "Unified DevOps lifecycle platform for Indian startups",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2"
  },
  "packageManager": "pnpm@9.14.4",
  "engines": {
    "node": ">=20.17"
  }
}
