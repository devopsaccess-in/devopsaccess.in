DATABASE_URL=postgres://{{ uptime_scheduler_db_user }}:{{ uptime_db_password | urlencode }}@127.0.0.1:5432/{{ uptime_db_name }}?sslmode=disable
SCHEDULER_WORKERS={{ scheduler_workers }}
# Alert emails via the local Postfix relay (mail_relay role); no auth.
SMTP_HOST=127.0.0.1
SMTP_PORT=25
ALERT_FROM={{ alert_from }}
