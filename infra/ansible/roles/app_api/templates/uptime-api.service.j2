[Unit]
Description=devopsaccess uptime control-plane API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=uptime-api
Group=uptime-api
EnvironmentFile=/opt/uptime-api/uptime-api.env
ExecStart=/opt/uptime-api/uptime-api
Restart=on-failure
RestartSec=3

# Hardening — the service only needs the network and its env file.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
