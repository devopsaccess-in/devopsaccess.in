API_LISTEN_ADDR={{ api_listen_addr }}
DATABASE_URL=postgres://{{ uptime_api_db_user }}:{{ uptime_db_password | urlencode }}@127.0.0.1:5432/{{ uptime_db_name }}?sslmode=disable
AUTH0_DOMAIN={{ auth0_domain }}
AUTH0_AUDIENCE={{ auth0_audience }}
# Channel-test emails via the local Postfix relay (mail_relay role); no auth.
SMTP_HOST=127.0.0.1
SMTP_PORT=25
ALERT_FROM={{ alert_from }}
