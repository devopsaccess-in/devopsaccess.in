CONTACT_LISTEN_ADDR={{ contact_listen_addr }}
# Send via the local Postfix relay (mail_relay role) over IPv4. No auth here —
# Postfix authenticates to Gmail. Empty SMTP_USER => the service skips AUTH.
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
CONTACT_TO={{ contact_to }}
CONTACT_FROM={{ smtp_user }}
CONTACT_ALLOWED_ORIGIN={{ contact_allowed_origin }}
DATABASE_URL=postgres://{{ db_user }}:{{ db_password | urlencode }}@127.0.0.1:5432/{{ db_name }}?sslmode=disable
RAZORPAY_WEBHOOK_SECRET={{ razorpay_webhook_secret }}
TURNSTILE_SECRET={{ turnstile_secret }}
