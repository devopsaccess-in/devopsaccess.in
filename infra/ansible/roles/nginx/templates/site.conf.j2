# ===========================================================================
# devopsaccess.in — served behind Cloudflare (Full Strict).
# TLS terminates here with the Cloudflare Origin certificate.
# ===========================================================================

# Redirect HTTP -> HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name {{ server_name }} www.{{ server_name }};
    return 301 https://{{ server_name }}$request_uri;
}

server {
    # http2 as a listen parameter — Ubuntu 24.04 ships nginx 1.24.0, which does
    # not support the standalone `http2 on;` directive (added in 1.25.1).
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ server_name }} www.{{ server_name }};

    ssl_certificate     /etc/nginx/tls/origin.pem;
    ssl_certificate_key /etc/nginx/tls/origin.key;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers off;

    # Authenticated Origin Pulls (mTLS) — two-stage, fail-safe rollout:
    #   nginx_aop_enabled  -> request + validate Cloudflare's client cert but DO
    #                         NOT reject (ssl_verify_client optional). Never breaks
    #                         the site; X-AOP-Verify exposes the result for checking.
    #   nginx_aop_enforce  -> only after you've confirmed X-AOP-Verify: SUCCESS,
    #                         reject anything that isn't a valid Cloudflare cert.
{% if nginx_aop_enabled | default(false) %}
    ssl_client_certificate /etc/nginx/tls/cloudflare-origin-pull-ca.pem;
    ssl_verify_client optional;
    add_header X-AOP-Verify $ssl_client_verify always;
{% if nginx_aop_enforce | default(false) %}
    if ($ssl_client_verify != SUCCESS) { return 403; }
{% endif %}
{% endif %}

    root {{ site_webroot }};
    index index.html;

    # Redirect www -> apex
    if ($host = www.{{ server_name }}) {
        return 301 https://{{ server_name }}$request_uri;
    }

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), browsing-topics=()" always;

    # Content-Security-Policy. Allowlists the third parties we actually load
    # (Cloudflare Turnstile + Web Analytics, Calendly, PostHog proxy, Google
    # Analytics). Fonts are self-hosted; payments use a Razorpay link (off-site).
    # 'unsafe-inline' on script/style is the pragmatic compromise for Astro's
    # inline scripts + Tailwind; 'unsafe-eval' is required by Turnstile (WASM).
    # Ships Report-Only by default (logs, never blocks); flip nginx_csp_enforce=
    # true after confirming zero console violations to enforce it.
{% set csp = "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://challenges.cloudflare.com https://assets.calendly.com https://www.googletagmanager.com https://r.devopsaccess.in https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' https://r.devopsaccess.in https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://challenges.cloudflare.com https://*.calendly.com https://cloudflareinsights.com https://static.cloudflareinsights.com; frame-src https://challenges.cloudflare.com https://calendly.com https://*.calendly.com; worker-src 'self' blob:" %}
{% if nginx_csp_enforce | default(false) %}
    add_header Content-Security-Policy "{{ csp }}" always;
{% else %}
    add_header Content-Security-Policy-Report-Only "{{ csp }}" always;
{% endif %}

    # Contact form API — reverse-proxied to the localhost Go service.
    location /api/ {
        proxy_pass http://127.0.0.1:{{ contact_proxy_port | default(8080) }};
        proxy_set_header Host $host;
        # Real visitor IP: behind Cloudflare $remote_addr is a CF edge IP, so use
        # CF-Connecting-IP. Safe because the firewall only admits Cloudflare.
        proxy_set_header X-Real-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Astro builds static HTML; try file, then directory index, then 404.
    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    # Long cache for hashed assets (Next.js static export)
    location /_next/static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /404.html {
        internal;
    }
    error_page 404 /404.html;

    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log;
}
