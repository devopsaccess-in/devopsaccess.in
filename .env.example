# Copy to .env.local and fill in. Never commit .env.local.

# Database
DATABASE_URL=postgresql://devopsaccess:dev@localhost:5432/devopsaccess

# Auth
AUTH_JWT_SECRET=change-me-in-production

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Hetzner
HCLOUD_TOKEN=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Observability (self)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=devopsaccess-api
