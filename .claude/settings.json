{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "attribution": {
    "commits": false,
    "pullRequests": false
  },

  "permissions": {
    "allow": [
      "Bash(pnpm install*)",
      "Bash(pnpm run *)",
      "Bash(pnpm test*)",
      "Bash(pnpm --filter * run *)",
      "Bash(pnpm --filter * test*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm build*)",
      "Bash(turbo run *)",
      "Bash(go build ./...)",
      "Bash(go test ./...)",
      "Bash(go test -v ./...)",
      "Bash(go test -run * ./...)",
      "Bash(go vet ./...)",
      "Bash(go mod tidy)",
      "Bash(go work sync)",
      "Bash(gofmt -l .)",
      "Bash(gofmt -w .)",
      "Bash(goimports -l .)",
      "Bash(goimports -w .)",
      "Bash(terraform init)",
      "Bash(terraform fmt*)",
      "Bash(terraform validate)",
      "Bash(terraform plan*)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(helm template*)",
      "Bash(helm list*)",
      "Bash(helm lint*)",
      "Bash(docker build*)",
      "Bash(docker compose *)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.*.local)",
      "Read(./**/terraform.tfvars)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.backup)",
      "Read(./**/secrets/**)",
      "Read(./**/*.kubeconfig)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(helm install*)",
      "Bash(helm upgrade*)",
      "Bash(helm uninstall*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard *)",
      "Bash(kubectl delete namespace*)"
    ]
  }
}
